# HER AREA Backend Environment Configuration
# Local Development Defaults

# Django Core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=her-area-secure-dev-key-9a8c7b6a-e5f4-3d2c-1b0f
ALLOWED_HOSTS=*

# Database (Leave blank for default local SQLite: her_area_dev.sqlite3)
# DATABASE_URL=postgresql://her_area_user:her_area_secret_password@127.0.0.1:5432/her_area_db

# Cache & Channels (Leave blank for local LocMemCache and InMemoryChannelLayer)
# REDIS_URL=redis://127.0.0.1:6379/1

# Razorpay (Optional in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ZeptoMail API (Required if you want real emails delivered to inboxes)
ZEPTOMAIL_SEND_MAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email

# ZeptoMail SMTP (Optional fallback, console backend used by default in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
